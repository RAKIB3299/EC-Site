<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Notifications | NEXORA</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css?v=23"></head><body><jsp:include page="/WEB-INF/views/includes/navigation.jsp"/><main class="page-container notifications-page"><div class="page-heading"><div><h1>Notifications</h1><p>Your latest order and shipping updates.</p></div><c:if test="${unreadNotificationCount>0}"><form method="post" action="${pageContext.request.contextPath}/notifications/read-all"><input type="hidden" name="returnTo" value="/notifications"><button class="small-button" type="submit">Mark all as read</button></form></c:if></div><c:choose><c:when test="${empty notifications}"><div class="notification-empty">No notifications yet.</div></c:when><c:otherwise><div class="notification-history"><c:forEach var="n" items="${notifications}"><a class="notification-history-item ${n.read?'':'notification-unread'}" href="${pageContext.request.contextPath}/notifications/open?id=${n.notificationId}"><span class="notification-indicator" aria-hidden="true"></span><span class="notification-copy"><strong><c:out value="${n.title}"/></strong><span><c:out value="${n.message}"/></span><small><c:out value="${n.notificationType}"/> &middot; <fmt:formatDate value="${n.createdAt}" pattern="yyyy-MM-dd HH:mm"/></small></span></a></c:forEach></div><c:if test="${totalPages>1}"><nav class="pagination" aria-label="Notification pages"><c:if test="${currentPage>1}"><a href="?page=${currentPage-1}">Previous</a></c:if><c:forEach begin="1" end="${totalPages}" var="p"><c:choose><c:when test="${p==currentPage}"><span class="current">${p}</span></c:when><c:otherwise><a href="?page=${p}">${p}</a></c:otherwise></c:choose></c:forEach><c:if test="${currentPage<totalPages}"><a href="?page=${currentPage+1}">Next</a></c:if></nav></c:if></c:otherwise></c:choose></main></body></html>



